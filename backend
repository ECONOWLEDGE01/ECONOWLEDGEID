+require('dotenv').config();
+const db = require('../db');
+const bcrypt = require('bcrypt');
+
+async function seed() {
+  try {
+    await db.query(`INSERT INTO roles (name) VALUES ('admin') ON CONFLICT (name) DO NOTHING`);
+    await db.query(`INSERT INTO roles (name) VALUES ('contributor') ON CONFLICT (name) DO NOTHING`);
+    await db.query(`INSERT INTO roles (name) VALUES ('user') ON CONFLICT (name) DO NOTHING`);
+
+    const email = 'admin@econowledge.id';
+    const password = process.env.SEED_ADMIN_PASSWORD || 'password123';
+    const saltRounds = 12;
+    const hash = await bcrypt.hash(password, saltRounds);
+
+    await db.query(
+      `INSERT INTO users (email, password_hash, role)
+       VALUES ($1, $2, 'admin')
+       ON CONFLICT (email) DO UPDATE SET password_hash = EXCLUDED.password_hash, role = EXCLUDED.role`,
+      [email, hash]
+    );
+
+    console.log('Seed selesai: admin dibuat/diupdate ->', email);
+    process.exit(0);
+  } catch (err) {
+    console.error('Seed gagal', err);
+    process.exit(1);
+  }
+}
+
+seed();
